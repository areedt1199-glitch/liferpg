NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional AI: server-only, disabled until owner configures a provider/model.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
# Example: GEMINI_ENABLED=true, GEMINI_API_KEY from https://aistudio.google.com/apikey, GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=
# Optional, used when the main model is busy (503), e.g. gemini-flash-lite-latest

# Server-only secret key (Supabase dashboard > Project Settings > API Keys > Secret keys, starts with sb_secret_).
# Lets the server record the guild teacher's review verdicts. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=
